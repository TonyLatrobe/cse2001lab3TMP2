# Instead of FROM nginx:1.25-alpine use our pre-built image for speed
FROM localhost:32000/nginx:old
# ❌ BAD: hardcoded secret
ENV API_KEY=super-secret-api-key-123

RUN apk add --no-cache curl bash openssl

COPY nginx/index.html /usr/share/nginx/html/index.html
# ❌ BAD: hardcoded secret (also)
COPY secrets.txt /app/secrets.txt


EXPOSE 80
